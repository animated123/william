rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Deny-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return (isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous') ||
             (isEmailVerified() && (
               exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
               request.auth.token.email == 'ngugimaina4@gmail.com'
             ));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidPracticeArea(data) {
      return data.keys().hasAll(['title', 'description', 'slug']) &&
             data.keys().hasOnly(['title', 'description', 'slug', 'statutoryFramework', 'caseScenarios', 'icon', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.slug is string && data.slug.size() <= 100;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['clientName', 'clientEmail', 'date', 'status', 'createdAt']) &&
             data.keys().hasOnly(['clientName', 'clientEmail', 'clientPhone', 'date', 'time', 'status', 'message', 'createdAt']) &&
             data.clientName is string && data.clientName.size() <= 100 &&
             data.clientEmail is string && data.clientEmail.size() <= 100 &&
             data.status in ['pending', 'confirmed', 'cancelled', 'completed'] &&
             data.createdAt == request.time;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
             data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt == request.time;
    }

    // 4. Collection Matches
    match /practice_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidPracticeArea(incoming());
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if isValidAppointment(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(incoming());
      allow read, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
