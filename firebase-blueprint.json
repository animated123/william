{
  "entities": {
    "PracticeArea": {
      "title": "Practice Area",
      "description": "Legal service category offered by the firm",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Name of the practice area" },
        "description": { "type": "string", "description": "Detailed description of the service" },
        "statutoryFramework": { "type": "string", "description": "Relevant Kenyan statutes and laws" },
        "caseScenarios": { "type": "string", "description": "Practical examples or case types" },
        "slug": { "type": "string", "description": "URL-friendly identifier" },
        "icon": { "type": "string", "description": "Lucide icon name" }
      },
      "required": ["title", "description", "slug"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Advocate or staff member profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "credentials": { "type": "string", "description": "Professional qualifications (e.g., LL.B, Dip. KSL)" },
        "order": { "type": "number" }
      },
      "required": ["name", "role", "order"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Legal insight or firm update",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["title", "content", "slug", "publishedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Client booking request",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"] },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientEmail", "date", "status", "createdAt"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Message from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with portal access",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "editor"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "practice_areas": {
      "schema": "PracticeArea",
      "description": "Collection of law firm services"
    },
    "team": {
      "schema": "TeamMember",
      "description": "Collection of firm advocates and staff"
    },
    "blogs": {
      "schema": "BlogPost",
      "description": "Collection of legal insights"
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Collection of client booking requests"
    },
    "contact_messages": {
      "schema": "ContactMessage",
      "description": "Collection of inquiries"
    },
    "admins": {
      "schema": "Admin",
      "description": "Collection of authorized administrators"
    }
  }
}
